# ===== Database =====
# ชื่อ database สร้างตาม database/SETUP.md ข้อ 1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pwa_pos
# ต้องเป็น pos_app เท่านั้น ถ้าใช้ postgres ระบบแยกข้อมูลระหว่างร้านจะไม่ทำงาน
DB_USERNAME=pos_app
DB_PASSWORD=

# ===== JWT =====
# สุ่มเอง อย่างน้อย 32 ตัวอักษร เครื่อง dev กับ production ต้องคนละค่า
# วิธีการสร้างค่า secret key สามารถใช้คำสั่งด้านล่างใน terminal
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ===== App =====
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173